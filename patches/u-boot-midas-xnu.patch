+#ifdef CONFIG_MIDAS_CHAINLOAD
+/*
+ * "getvar mem:<hex addr>": 4 words at addr. Bring-up mailbox readback after a
+ * watchdog reset; arbitrary memory read, so only in the chainload dev build.
+ */
+static void getvar_mem(char *var_parameter, char *response)
+{
+	u32 *p;
+
+	if (!var_parameter) {
+		fastboot_fail("usage: mem:<hex addr>", response);
+		return;
+	}
+	p = (u32 *)(simple_strtoul(var_parameter, NULL, 16) & ~3UL);
+	fastboot_response("OKAY", response, "%08x %08x %08x %08x",
+			  p[0], p[1], p[2], p[3]);
+}
+#endif
