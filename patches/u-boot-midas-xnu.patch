+#define LPM_FB_PA	0x60000000UL
+#define LPM_W		720
+#define LPM_H		1280
+
+static void lpm_fill_rect(u32 *fb, int x, int y, int w, int h, u32 col)
+{
+	int ix, iy;
+
+	if (x < 0) { w += x; x = 0; }
+	if (y < 0) { h += y; y = 0; }
+	if (x + w > LPM_W) w = LPM_W - x;
+	if (y + h > LPM_H) h = LPM_H - y;
+	for (iy = y; iy < y + h; iy++) {
+		u32 *row = fb + iy * LPM_W + x;
+		for (ix = 0; ix < w; ix++)
+			row[ix] = col;
+	}
+}
+
+static void lpm_draw_glyph(u32 *fb, int x0, int y0, int scale, int idx, u32 col)
+{
+	/* 5x7 glyphs for '0'..'9' (0..9) and '%' (10) */
+	static const u8 font[11][7] = {
+		{ 0x0e, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0e }, /* 0 */
+		{ 0x04, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x0e }, /* 1 */
+		{ 0x0e, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1f }, /* 2 */
+		{ 0x1f, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0e }, /* 3 */
+		{ 0x02, 0x06, 0x0a, 0x12, 0x1f, 0x02, 0x02 }, /* 4 */
+		{ 0x1f, 0x10, 0x1e, 0x01, 0x01, 0x11, 0x0e }, /* 5 */
+		{ 0x06, 0x08, 0x10, 0x1e, 0x11, 0x11, 0x0e }, /* 6 */
+		{ 0x1f, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 }, /* 7 */
+		{ 0x0e, 0x11, 0x11, 0x0e, 0x11, 0x11, 0x0e }, /* 8 */
+		{ 0x0e, 0x11, 0x11, 0x0f, 0x01, 0x02, 0x0c }, /* 9 */
+		{ 0x18, 0x19, 0x02, 0x04, 0x08, 0x13, 0x03 }, /* % */
+	};
+	int r, c;
+
+	if (idx < 0 || idx > 10)
+		return;
+	for (r = 0; r < 7; r++)
+		for (c = 0; c < 5; c++)
+			if (font[idx][r] & (1u << (4 - c)))
+				lpm_fill_rect(fb, x0 + c * scale, y0 + r * scale,
+					      scale, scale, col);
+}
+
+static void lpm_draw_screen(int soc)
+{
+	u32 *fb = (u32 *)LPM_FB_PA;
+	int bx = 224, by = 520, bw = 260, bh = 124, bdr = 6, pad = 10;
+	int inner_w = bw - 2 * (bdr + pad);
+	int fill_w;
+	u32 fill_col;
+	int digs[4], nd = 0, s, tw, tx, ty, i;
+
+	if (soc < 0) soc = 0;
+	if (soc > 100) soc = 100;
+	fill_w = (inner_w * soc) / 100;
+	if (soc > 0 && fill_w < 8)
+		fill_w = 8;
+	fill_col = (soc <= 15) ? 0xffff3b30u : 0xff34c759u; /* iOS Red / Green */
+
+	/* Pure black OLED background */
+	lpm_fill_rect(fb, 0, 0, LPM_W, LPM_H, 0xff000000u);
+	/* Battery body outline + inner well + positive terminal cap */
+	lpm_fill_rect(fb, bx, by, bw, bh, 0xff8e8e93u);
+	lpm_fill_rect(fb, bx + bdr, by + bdr, bw - 2 * bdr, bh - 2 * bdr, 0xff141416u);
+	lpm_fill_rect(fb, bx + bw + 4, by + 36, 14, bh - 72, 0xff8e8e93u);
+	/* Live charge bar */
+	if (fill_w > 0)
+		lpm_fill_rect(fb, bx + bdr + pad, by + bdr + pad,
+			      fill_w, bh - 2 * (bdr + pad), fill_col);
+
+	/* Centered percentage digits (e.g. "86%") */
+	s = soc;
+	if (s >= 100) {
+		digs[nd++] = 1; digs[nd++] = 0; digs[nd++] = 0;
+	} else if (s >= 10) {
+		digs[nd++] = s / 10; digs[nd++] = s % 10;
+	} else {
+		digs[nd++] = s;
+	}
+	digs[nd++] = 10; /* '%' */
+	tw = nd * (5 * 6 + 10) - 10;
+	tx = (LPM_W - tw) / 2;
+	ty = by + bh + 44;
+	for (i = 0; i < nd; i++)
+		lpm_draw_glyph(fb, tx + i * 40, ty, 6, digs[i], 0xffe5e5eau);
+
+	flush_dcache_range(LPM_FB_PA, LPM_FB_PA + (ulong)LPM_W * LPM_H * 4UL);
+}
+
+static void lpm_blank_screen(void)
+{
+	/* Paint pure black and let 1 frame scan out before DCS 0x28/0x10 so s6e8aa0 never flashes. */
+	lpm_fill_rect((u32 *)LPM_FB_PA, 0, 0, LPM_W, LPM_H, 0xff000000u);
+	flush_dcache_range(LPM_FB_PA, LPM_FB_PA + (ulong)LPM_W * LPM_H * 4UL);
+	mdelay(25);
+	xnufb_display_enable(0);
+}
+
+static enum boot_mode midas_lpm_charge(void)
+{
+	struct udevice *bat = NULL, *extcon = NULL, *charger = NULL;
+	int cur = 0, soc = 0, disp_on = 1, disp_inited = 0;
+	int screen_ms = 0, pwr_ms = 0, vdown_ms = 0, unplug_cnt = 0, tick = 0;
+
+	printf("Entering offline charging (LPM) mode\n");
+	uclass_get_device(UCLASS_BATTERY, 0, &bat);
+	uclass_get_device(UCLASS_EXTCON, 0, &extcon);
+	uclass_get_device(UCLASS_CHARGER, 0, &charger);
+
+	if (extcon)
+		cur = extcon_get_max_charge_current(extcon);
+	if (charger)
+		charger_set_current(charger, cur > 0 ? cur : 500000);
+	if (bat)
+		soc = battery_get_soc(bat);
+
+	int last_full = (soc >= 95);
+
+	midas_led_action(LED_RED | LED_GREEN | LED_BLUE, LEDST_OFF);
+	midas_led_action(last_full ? LED_GREEN : LED_RED, LEDST_ON);
+
+	if (IS_ENABLED(CONFIG_MIDAS_CHAINLOAD)) {
+		lpm_draw_screen(soc);
+		if (xnufb_start(LPM_FB_PA, 32) == 0)
+			disp_inited = 1;
+	}
+
+	for (;;) {
+		int pwr, home, vdown;
+
+		mdelay(50);
+		tick++;
+
+		/* Charger disconnect -> power off cleanly */
+		if (extcon) {
+			cur = extcon_get_max_charge_current(extcon);
+			if (cur <= 0) {
+				if (++unplug_cnt >= 4) {
+					printf("LPM: charger unplugged, powering off\n");
+					if (disp_inited && disp_on)
+						lpm_blank_screen();
+					midas_led_action(LED_RED | LED_GREEN | LED_BLUE, LEDST_OFF);
+					midas_power_off();
+				}
+			} else {
+				unplug_cnt = 0;
+			}
+		}
+
+		pwr   = !gpio_get_value(EXYNOS4X12_GPIO_X27);
+		home  = !gpio_get_value(EXYNOS4X12_GPIO_X01);
+		vdown = !gpio_get_value(EXYNOS4X12_GPIO_X33);
+
+		/* Hold Vol-Down (>=300ms) -> fastboot */
+		if (vdown) {
+			vdown_ms += 50;
+			if (vdown_ms >= 300) {
+				if (disp_inited && !disp_on)
+					xnufb_display_enable(1);
+				return MODE_FASTBOOT;
+			}
+		} else {
+			vdown_ms = 0;
+		}
+
+		/* Hold Power (>=800ms) -> boot iOS; short press -> toggle OLED */
+		if (pwr) {
+			pwr_ms += 50;
+			if (pwr_ms >= 800) {
+				printf("LPM: power held, booting iOS\n");
+				if (disp_inited && !disp_on)
+					xnufb_display_enable(1);
+				return MODE_SKIP_LPM;
+			}
+		} else {
+			if (pwr_ms > 0 && pwr_ms < 800 && disp_inited) {
+				if (disp_on) {
+					lpm_blank_screen();
+					disp_on = 0;
+				} else {
+					if (bat) soc = battery_get_soc(bat);
+					lpm_draw_screen(soc);
+					xnufb_display_enable(1);
+					disp_on = 1;
+					screen_ms = 0;
+				}
+			}
+			pwr_ms = 0;
+		}
+
+		/* Home press wakes screen for 8s */
+		if (home && disp_inited) {
+			if (!disp_on) {
+				if (bat) soc = battery_get_soc(bat);
+				lpm_draw_screen(soc);
+				xnufb_display_enable(1);
+				disp_on = 1;
+			}
+			screen_ms = 0;
+		}
+
+		/* Refresh SoC, LED (only on state change) and charging gauge every ~2s */
+		if (tick % 40 == 0) {
+			int full;
+
+			if (bat)
+				soc = battery_get_soc(bat);
+			full = (soc >= 95);
+			if (full != last_full) {
+				midas_led_action(LED_RED | LED_GREEN | LED_BLUE, LEDST_OFF);
+				midas_led_action(full ? LED_GREEN : LED_RED, LEDST_ON);
+				last_full = full;
+			}
+			if (disp_inited && disp_on)
+				lpm_draw_screen(soc);
+		}
+
+		/* Auto-blank OLED after 8s to save power and avoid burn-in */
+		if (disp_inited && disp_on) {
+			screen_ms += 50;
+			if (screen_ms >= 8000) {
+				lpm_blank_screen();
+				disp_on = 0;
+			}
+		}
+	}
+}
+
 int exynos_late_init(void)
 {
+	struct exynos4412_power *pwr = (struct exynos4412_power *)samsung_get_base_power();
+	u32 rst_stat = readl(&pwr->rst_stat);
+
 	board_load_info();
 
 	env_set("bootmode", "normal");
 	enum boot_mode mode = midas_get_boot_mode();
 	if (mode == MODE_NONE)
 		mode = midas_check_keycombo();
+	/*
+	 * Chainloaded copy: auto-boot XNU from eMMC CACHE partition (xnuboot) on normal power-on
+	 * with zero USB required. Hold Vol-Down (or Vol-Down+Home) or trigger INFORM3=MODE_FASTBOOT
+	 * to enter fastboot instead.
+	 */
+	if (IS_ENABLED(CONFIG_MIDAS_CHAINLOAD) &&
+	    mode != MODE_FASTBOOT && mode != MODE_RECOVERY && mode != MODE_CONSOLE &&
+	    !gpio_get_value(EXYNOS4X12_GPIO_X33))
+		mode = MODE_FASTBOOT;
 
 	enum battery_boot_mode bat_state = midas_check_battery();
 	if (bat_state == BATTERY_ABORT) {
 		/* release PS_HOLD - turn off board */
 		midas_power_off();
 	} else if (bat_state == BATTERY_LPM && mode == MODE_NONE) {
-		env_set("bootmode", "lpm");
+		/* Enter offline charging only on cold boot (not WDT/SW reboot from running iOS) */
+		if (IS_ENABLED(CONFIG_MIDAS_CHAINLOAD) &&
+		    !(rst_stat & 0x20000f00u)) {
+			mode = midas_lpm_charge();
+		} else {
+			env_set("bootmode", "lpm");
+		}
 	}
 
 	init_overlays();
@@ -537,6 +804,8 @@ int exynos_late_init(void)
 	default:
 		printf("Booting normally...\n");
 		midas_led_action(LED_GREEN | LED_RED, LEDST_ON);
+		if (IS_ENABLED(CONFIG_MIDAS_CHAINLOAD))
+			env_set("bootcmd", "run xnuboot");
 	}
 
 	return 0;
