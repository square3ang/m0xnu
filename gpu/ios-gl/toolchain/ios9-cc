#!/usr/bin/env python3
"""Clang + cctools ld64 wrapper for armv7-apple-ios9.0 (C / C++ / ObjC)."""
import os, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
LD = os.path.join(ROOT, "tools/cctools/bin/arm-apple-darwin11-ld")
STUB = os.path.join(ROOT, "out/ios-gl/stubs")
RES = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()

prog = os.path.basename(sys.argv[0])
is_cxx = "cxx" in prog or "++" in prog
compiler = "clang++" if is_cxx else "clang"
args = sys.argv[1:]

# Pass version queries straight through for Meson compiler detection.
if any(a in ("--version", "-v", "-dM", "-E") for a in args) and "-c" not in args and "-o" not in args:
    sys.exit(subprocess.call([compiler, "--target=armv7-apple-ios9.0", *args]))

DRM_INC = os.path.join(ROOT, "gpu/ios-gl/toolchain/drm/include")
UAPI_INC = os.path.join(ROOT, "gpu/mesa-lima/include/drm-uapi")
inc_flags = [
    "--target=armv7-apple-ios9.0",
    "-mcpu=cortex-a9",
    "-mfpu=neon",
    "-mthumb",
    "-nostdinc",
    "-isystem", os.path.join(RES, "include"),
    "-isystem", "/usr/lib/zig/libc/include/any-darwin-any",
    "-isystem", DRM_INC,
    "-isystem", UAPI_INC,
]
if is_cxx:
    inc_flags = [
        "--target=armv7-apple-ios9.0",
        "-mcpu=cortex-a9",
        "-mfpu=neon",
        "-mthumb",
        "-nostdinc", "-nostdinc++",
        "-D_LIBCPP_HARDENING_MODE_DEFAULT=_LIBCPP_HARDENING_MODE_NONE",
        "-D_LIBCPP_ASSERTION_SEMANTIC_DEFAULT=_LIBCPP_ASSERTION_SEMANTIC_IGNORE",
        "-D_LIBCPP_HAS_THREADS=1",
        "-D_LIBCPP_HAS_MONOTONIC_CLOCK=1",
        "-isystem", "/usr/lib/zig/libcxx/include",
        "-isystem", os.path.join(RES, "include"),
        "-isystem", "/usr/lib/zig/libc/include/any-darwin-any",
        "-isystem", DRM_INC,
        "-isystem", UAPI_INC,
    ]

# Strip Linux-only macros that Meson auto-detected due to dynamic_lookup link checks.
undef_flags = [
    "-UHAVE_SECURE_GETENV", "-UHAS_SCHED_GETAFFINITY", "-UHAVE_MALLINFO2",
    "-UHAVE_DL_ITERATE_PHDR", "-UHAVE_POSIX_FALLOCATE", "-UHAVE_RANDOM_R",
    "-UHAVE_QSORT_S", "-UHAVE_FMEMOPEN", "-UHAVE_ENDIAN_H", "-UHAVE_CET_H",
    "-UHAVE_ZLIB", "-UHAVE_COMPRESSION", "-UUSE_LIBELF",
    "-UHAVE___BUILTIN_ADD_OVERFLOW_P", "-UHAVE___BUILTIN_SUB_OVERFLOW_P",
]

# Compile-only / preprocess-only: invoke clang directly.
if any(a in ("-c", "-E", "-S") for a in args):
    sys.exit(subprocess.call([compiler, *inc_flags, *args, *undef_flags]))

# Link step: let clang drive our arm-apple-darwin11-ld via -fuse-ld=.
# ld64 requires libSystem.B.dylib for every armv7 link; bootstrap a minimal stub on a clean
# checkout (e.g. `meson setup` before `gpu/ios-gl/build.sh` builds the full stubs).
libsystem = os.path.join(STUB, "libSystem.B.dylib")
if not os.path.exists(libsystem):
    os.makedirs(STUB, exist_ok=True)
    tmp_c = os.path.join(STUB, "_boot_libSystem.c")
    tmp_o = os.path.join(STUB, "_boot_libSystem.o")
    kern_d = os.path.join(STUB, "libsystem_kernel.dylib")
    with open(tmp_c, "w") as f:
        f.write('__asm__(".align 2\\n.globl dyld_stub_binder\\ndyld_stub_binder: bx lr\\n");\n')
    subprocess.check_call(["clang", "--target=armv7-apple-ios9.0", "-mthumb", "-c", tmp_c, "-o", tmp_o])
    subprocess.check_call([LD, "-arch", "armv7", "-ios_version_min", "9.0", "-dylib",
                           "-install_name", "/usr/lib/system/libsystem_kernel.dylib", "-o", kern_d, tmp_o])
    subprocess.check_call([LD, "-arch", "armv7", "-ios_version_min", "9.0", "-dylib",
                           "-install_name", "/usr/lib/libSystem.B.dylib", "-o", libsystem, tmp_o, kern_d])
link_flags = [
    f"-fuse-ld={LD}",
    "-nostdlib",
    f"-L{STUB}",
    libsystem,
    "-Wl,-undefined,dynamic_lookup",
]
sys.exit(subprocess.call([compiler, *inc_flags, *args, *link_flags]))
